---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<article class="card">
  <div class="shot">
    <Image
      src={project.image}
      alt={project.alt}
      widths={[480, 720, 960]}
      sizes="(min-width: 860px) 480px, 100vw"
      format="webp"
      loading="lazy"
    />
  </div>
  <div class="body">
    <p class="kind">{project.kind}</p>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    <ul class="tags" aria-label="Technologies">
      {project.stack.map((s) => <li>{s}</li>)}
    </ul>
    <p class="links">
      {
        project.links.map((l) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label} <span aria-hidden="true">↗</span>
          </a>
        ))
      }
    </p>
  </div>
</article>
